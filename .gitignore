# ===== AI-SDLC exclusions =====

# Python
__pycache__/
*.pyc
.venv/
venv/

# Component runtime state (regenerable)
output/
logs/
*.log

# SkillBox runtime telemetry + reports (regenerable; lineage + registry are tracked)
.skillbox/telemetry/raw/
.skillbox/telemetry/sessions/
.skillbox/telemetry/quarantine/
.skillbox/telemetry/decisions/
.skillbox/telemetry/metrics/
.skillbox/telemetry/dashboards/
.skillbox/telemetry/skillbox.db
.skillbox/telemetry/skillbox.db-shm
.skillbox/telemetry/skillbox.db-wal
.skillbox/learnings/
.skillbox/reports/
.skillbox/generated/.last_learning_run

# Code Knowledge Graph regenerable artifacts
output/kg/

# Dashboards are tracked (content-hash gated); scratch renders elsewhere are not
*.html.tmp

# Local scratch
*.tmp
.DS_Store
mlruns/
mlflow.db*
